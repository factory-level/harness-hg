{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-gitops.factorylevel.dev/examples/communication-plane/events/demo-alert/v1.schema.json",
  "title": "source.demo.alert/v1",
  "description": "The external demo alert source's normalized payload - what the shared webhook gateway accepts on the demo-alert-source binding after signature verification. incident is the subject dot-path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident",
    "severity",
    "summary"
  ],
  "properties": {
    "incident": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string"
    }
  }
}
