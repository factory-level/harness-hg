{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "strict": true,
        "types": ["bun-types"]
    },
    "include": ["src/**/*.ts"]
}
