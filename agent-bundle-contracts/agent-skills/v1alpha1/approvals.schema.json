{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-gitops.factorylevel.dev/schemas/agent-skills/v1alpha1/approvals.schema.json",
  "title": "SkillApprovals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "approvals"
  ],
  "properties": {
    "apiVersion": {
      "const": "hermes-gitops.factorylevel.dev/agent-skills/v1alpha1"
    },
    "kind": {
      "const": "SkillApprovals"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "fingerprint",
          "approvedBy",
          "approvedAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          },
          "approvedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
          }
        }
      }
    }
  }
}
