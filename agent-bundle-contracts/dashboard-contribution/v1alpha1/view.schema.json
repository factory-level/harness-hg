{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-gitops.factorylevel.dev/schemas/dashboard-contribution/v1alpha1/view.schema.json",
  "title": "Nexus default view (dashboard/views/<view>.yaml)",
  "description": "The repository-provided default layout: where contributed components sit on the canvas and the initial viewport. Versioned with the persona repository. Operator edits never touch this file - they live in a local overlay on the control-plane host, patched over this default at render time. A node ref naming an unknown component is a compile error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "coordinate": {
      "type": "number",
      "minimum": -100000,
      "maximum": 100000
    }
  },
  "properties": {
    "apiVersion": {
      "const": "dashboard.hermes-gitops/v1alpha1"
    },
    "kind": {
      "const": "NexusView"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/componentId",
          "description": "View identity; the file is conventionally named <id>.yaml. `default` is the view the canvas opens with."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "position"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/componentId",
                "description": "A component, person or group id from the repository's contributions."
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "$ref": "#/$defs/coordinate"
                  },
                  "y": {
                    "$ref": "#/$defs/coordinate"
                  }
                }
              },
              "parent": {
                "$ref": "#/$defs/componentId",
                "description": "Group id this node is placed inside."
              }
            }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          }
        }
      }
    }
  }
}
