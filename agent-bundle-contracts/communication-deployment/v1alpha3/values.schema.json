{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-gitops.factorylevel.dev/schemas/communication-deployment/v1alpha3/values.schema.json",
  "title": "Event-router configuration (deployments/communication/<id>/values.yaml)",
  "description": "v1alpha3: v1alpha2 plus an OPTIONAL `spec.connections` - the inbound connection gateway: one entry per platform connection (a Discord application, a GitHub App) with the provider, the name of the platform Secret the router mounts, the key that verifies inbound requests, and the ORDERED routes (match rule -> the bound eve agent's channel URL). The router verifies the provider's signature on POST /v1/connect/<provider>/<name>, picks the first matching route, and forwards the request verbatim. v1alpha2: v1alpha1 plus two OPTIONAL top-level environment knobs the emitter writes only when asked - `image` (an environment-specific router image, e.g. a baseline-CPU bun build) and `recordingBase` (the debug-observer/recording sink base URL; the router posts recording-provider ChatOps captures AND sanitized lifecycle records there). Both are chart values, layered by the ApplicationSet exactly like spec. Everything else is unchanged: the router instance's ENTIRE routing configuration, compiler-written; the compiled graph, not the runtime, is the authority on routing, and a payload can never select a destination this file does not declare. Credential REFERENCES only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec"
  ],
  "$defs": {
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "retry",
        "deadLetter"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "direct",
            "queued"
          ]
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxAttempts",
            "backoff"
          ],
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            },
            "backoff": {
              "type": "string",
              "enum": [
                "fixed",
                "exponential"
              ]
            }
          }
        },
        "deadLetter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "retention": {
              "type": "string"
            }
          }
        },
        "ordering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key",
            "onFailure"
          ],
          "properties": {
            "mode": {
              "const": "fifo"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "onFailure": {
              "type": "string",
              "enum": [
                "block",
                "dead-letter-and-continue"
              ]
            }
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Optional container image override for the router (environment knob, e.g. a baseline-CPU build for pre-AVX2 hosts). Omitted = the chart default."
    },
    "recordingBase": {
      "type": "string",
      "minLength": 1,
      "pattern": "^https?://\\S+$",
      "description": "Optional debug-observer / recording sink base URL. A URL, never a credential - the sink authenticates nothing and receives metadata only."
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router",
        "chatopsConnections",
        "producers",
        "externalInputs",
        "edges"
      ],
      "properties": {
        "router": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "scope",
            "namespace",
            "service"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "durableProvider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plugin"
          ],
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "config": {
              "type": "object"
            }
          }
        },
        "chatopsConnections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "credentialRef": {
                "$ref": "#/$defs/credentialRef"
              }
            }
          }
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "profile",
              "app",
              "appInstance",
              "output",
              "event",
              "ingestPath",
              "routes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "app": {
                "type": "string",
                "minLength": 1
              },
              "appInstance": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string"
              },
              "subject": {
                "type": "string",
                "description": "Payload dot-path the router extracts envelope.subject from."
              },
              "ingestPath": {
                "type": "string",
                "pattern": "^/v1/events/"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "externalInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "profile",
              "name",
              "event",
              "verification",
              "hookPath",
              "routes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "secretRef"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "secretRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "key"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "accepts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hookPath": {
                "type": "string",
                "pattern": "^/v1/hooks/"
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "route",
              "profile",
              "from",
              "event",
              "kind",
              "delivery"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "producer": {
                    "type": "string"
                  },
                  "externalInput": {
                    "type": "string"
                  }
                }
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "filter": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "kind": {
                "type": "string",
                "enum": [
                  "agent",
                  "chatops"
                ]
              },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "handler",
                  "instance",
                  "namespace",
                  "service",
                  "port",
                  "path",
                  "url",
                  "signature",
                  "secretName",
                  "session"
                ],
                "properties": {
                  "profile": {
                    "type": "string"
                  },
                  "handler": {
                    "type": "string"
                  },
                  "instance": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "service": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "path": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "description": "The in-cluster URL of the handler on the target profile's OWN Hermes gateway - the router delivers here, HMAC-signed, and never hosts the handler itself."
                  },
                  "signature": {
                    "type": "string"
                  },
                  "secretName": {
                    "type": "string",
                    "description": "The instance's env Secret (WEBHOOK_SECRET lives there). A reference - the value never appears in this tree."
                  },
                  "session": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "per-event",
                          "keyed",
                          "route"
                        ]
                      },
                      "key": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "chatops": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "space",
                  "alias",
                  "destination",
                  "provider"
                ],
                "properties": {
                  "space": {
                    "type": "string"
                  },
                  "alias": {
                    "type": "string"
                  },
                  "destination": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  }
                }
              },
              "delivery": {
                "$ref": "#/$defs/delivery"
              }
            }
          }
        },
        "connections": {
          "description": "The connection gateway's configuration, compiler-written from environment/connections.yaml.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider",
              "secretName",
              "verifyKey",
              "routes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 40
              },
              "provider": {
                "type": "string",
                "enum": [
                  "discord",
                  "github"
                ]
              },
              "secretName": {
                "type": "string",
                "minLength": 1,
                "description": "The platform Secret (hermes-secrets/<secretName>) the chart mounts at /secrets/connections/<name>/."
              },
              "verifyKey": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "The key inside that Secret the gateway verifies with (DISCORD_PUBLIC_KEY, GITHUB_WEBHOOK_SECRET)."
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profile",
                    "url",
                    "match"
                  ],
                  "properties": {
                    "profile": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^http://",
                      "description": "The bound agent's channel route (in-cluster Service URL)."
                    },
                    "match": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "guilds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "channels": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "repositories": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
