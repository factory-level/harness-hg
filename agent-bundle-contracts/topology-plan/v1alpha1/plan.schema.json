{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-gitops.factorylevel.dev/schemas/topology-plan/v1alpha1/plan.schema.json",
  "title": "Whole-fleet plan summary (deployments/plan.yaml)",
  "description": "The compiler's summary of one atomic regeneration, written LAST: instance and binding tables plus inputsHash - sha256 over every input file (authored contracts + environment files), the staleness signal `hg topology doctor` and `hg status` compare against a recomputation. Staleness is detected, never scheduled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "layout", "sovereignty", "inputsHash", "agents", "apps", "bindings"],
  "properties": {
    "version": {"const": 1},
    "layout": {"type": "string", "enum": ["single", "replicated", "hub-spoke"]},
    "sovereignty": {"type": "string", "enum": ["permissive", "strict"]},
    "inputsHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agents": {"type": "array", "items": {"type": "string"}},
    "apps": {"type": "array", "items": {"type": "string"}},
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "consumer", "provider", "url", "crossRegion"],
        "properties": {
          "capability": {"type": "string"},
          "consumer": {"type": "string"},
          "provider": {"type": "string"},
          "url": {"type": "string"},
          "crossRegion": {"type": "boolean"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"synthesized": {"type": "boolean"}}
    }
  }
}
